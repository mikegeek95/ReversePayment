package Utils;

import java.sql.Date;
import java.sql.Timestamp;
import java.util.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import com.bbva.kmic.dto.commonmodel.*;
import com.bbva.kmic.dto.movementmodel.MicroloanMovement;
import com.bbva.kmic.dto.payments.ProductInputDTO;

public class Mapper {
    private static final Pattern DATE_PATTERN = Pattern.compile("(\\d{4})-(\\d{2})-(\\d{2})");
    private static final Logger LOGGER = LoggerFactory.getLogger(Mapper.class);

    private Mapper() {}

    public static List<MicroloanMovement> mapListMicroloanMovement(List<Map<String, Object>> resultSet) {
        List<MicroloanMovement> list = new ArrayList<>();
        if (resultSet != null) {
            for (Map<String, Object> row : resultSet) {
                list.add(mapMicroloanMovement(row));
            }
        }
        return list;
    }

    public static MicroloanMovement mapMicroloanMovement(Map<String, Object> row) {
        MicroloanMovement mm = new MicroloanMovement();
        mm.setContractId(readString(row.get("G_CONTRACT_ID")));
        mm.setDate(readDate(row.get("GF_MOV_DATE")));
        mm.setNumber(readInt(row.get("GF_SEQUENCE_ID")));
        mm.setMicroloanId(readString(row.get("GF_OPERATION_PAGE_ID")));
        mm.setInstallmentDate(readDate(row.get("GF_INSTALLMENT_PERIOD_DATE")));
        mm.setInterbankTrackingDescription(readString(row.get("GF_TRACKING_TRANSACTION_DESC")));
        mm.setChannelCode(readString(row.get("GF_APP_CHANNEL_ID")));

        mm.setAccount(readAccount(row));
        mm.setAmount(readAmount(row));
        mm.setRelatedContract(readRelatedContract(row));
        mm.setAudit(readAudit(row));

        return mm;
    }

    public static Map<String, Object> hashMicroloanMovement(MicroloanMovement bean) {
        Map<String, Object> map = new HashMap<>();
        map.put("contractId", bean.getContractId());
        map.put("date", bean.getDate());
        map.put("number", bean.getNumber());
        map.put("microloanId", bean.getMicroloanId());
        map.put("interbankDesc", bean.getInterbankTrackingDescription());
        map.put("installmentDate", bean.getInstallmentDate());
        map.put("channel", bean.getChannelCode());

        Account acc = bean.getAccount();
        if (acc != null) {
            map.put("accountNumber", acc.getNumber());
            map.put("accountDate", acc.getDate());
            map.put("accountCode", acc.getCoded());
            map.put("accountPosition", acc.getPositionNumber());

            AccountEvent event = acc.getEvent();
            if (event != null) {
                map.put("eventCode", event.getCode());
                map.put("eventStatus", event.getStatus());

                RegionalCenter rc = event.getRegionalCenter();
                if (rc != null) {
                    map.put("rcOperative", rc.getOperative());
                    map.put("rcOrigin", rc.getOrigin());
                    map.put("rcDestiny", rc.getDestiny());
                }
            }
        }

        Amount amt = bean.getAmount();
        if (amt != null) {
            map.put("amount", amt.getAmount());
            map.put("currency", amt.getCurrency());
        }

        RelatedContract rel = bean.getRelatedContract();
        if (rel != null) {
            map.put("contractType", rel.getContractType());
            map.put("contractNumber", rel.getNumber());
        }

        Audit audit = bean.getAudit();
        if (audit != null) {
            map.put("auditUserCode", audit.getUserCode());
            if (audit.getTimestamp() != null) {
                map.put("auditTimestamp", audit.getTimestamp().getTime());
            }
        }

        return map;
    }

    // --- Private helpers ---

    private static Account readAccount(Map<String, Object> row) {
        Account account = new Account();
        AccountEvent event = new AccountEvent();
        RegionalCenter rc = new RegionalCenter();

        account.setNumber(readString(row.get("GF_ACCT_MOV_ID")));
        account.setDate(readDate(row.get("GF_GL_ACCOUNT_DATE")));
        account.setCoded(readString(row.get("GF_GL_ACCOUNTING_STRING_ID")));
        account.setPositionNumber(readString(row.get("GF_ACCOUNTING_POSITION_ID")));

        event.setCode(readString(row.get("G_MICROCREDIT_MOVEMENT_TYPE")));
        event.setStatus(readString(row.get("G_ACTIVE_MOVEMENT_IND_TYPE")));

        rc.setDestiny(readString(row.get("GF_NEW_CUST_REGIONAL_CENTRE_ID")));
        rc.setOperative(readString(row.get("GF_CUSTOMER_PROPOSAL_BRANCH_ID")));
        rc.setOrigin(readString(row.get("GF_CREDIT_REQUEST_ORIGIN_RC_ID")));

        event.setRegionalCenter(rc);
        account.setEvent(event);

        return account;
    }

    private static Amount readAmount(Map<String, Object> row) {
        Amount amt = new Amount();
        amt.setAmount(readDouble(row.get("GF_MOVEMENT_AMOUNT")));
        amt.setCurrency(readString(row.get("G_CURRENCY_ID")));
        return amt;
    }

    private static RelatedContract readRelatedContract(Map<String, Object> row) {
        RelatedContract rc = new RelatedContract();
        rc.setContractType(readString(row.get("G_LOCAL_CONTRACT_TYPE")));
        rc.setNumber(readString(row.get("GF_MOV_ASSO_ACCOUNT_ID")));
        return rc;
    }

    private static Audit readAudit(Map<String, Object> row) {
        Audit audit = new Audit();
        audit.setUserCode(readString(row.get("GF_USER_AUDIT_ID")));
        audit.setTimestamp(readTimestamp(row.get("GF_AUDIT_DATE")));
        return audit;
    }

    private static String readString(Object o) {
        return o == null ? null : Objects.toString(o, null);
    }

    private static Date readDate(Object o) {
        if (o instanceof Date) return (Date) o;

        if (o instanceof String) {
            Matcher m = DATE_PATTERN.matcher((String) o);
            if (m.matches()) {
                Calendar c = Calendar.getInstance();
                c.clear();
                c.set(Calendar.YEAR, Integer.parseInt(m.group(1)));
                c.set(Calendar.MONTH, Integer.parseInt(m.group(2)) - 1);
                c.set(Calendar.DAY_OF_MONTH, Integer.parseInt(m.group(3)));
                return (Date) c.getTime();
            }
        }
        return null;
    }

    private static double readDouble(Object o) {
        return (o instanceof Number) ? ((Number) o).doubleValue() : 0.0;
    }

    private static int readInt(Object o) {
        if (o instanceof Number) return ((Number) o).intValue();
        if (o instanceof String) return Integer.parseInt((String) o);
        return 0;
    }

    private static Calendar readTimestamp(Object o) {
        if (o instanceof Timestamp) {
            Calendar c = Calendar.getInstance();
            c.setTimeInMillis(((Timestamp) o).getTime());
            return c;
        }
        return null;
    }
    
    public static MicroloanMovement mapToMicroloanMovement(ProductInputDTO dto) {
        MicroloanMovement movement = new MicroloanMovement();

        movement.setContractId(dto.getContractId());
        movement.setMicroloanId(dto.getMicroloanId());
        movement.setInstallmentDate(dto.getInstallmentDate());

        Amount amount = new Amount();
        amount.setAmount(dto.getAmount());
        movement.setAmount(amount);

        return movement;
    }
    
    public static Map<String, Object> buildQueryParams(MicroloanMovement movement) {
        Map<String, Object> params = new HashMap<>();
        LOGGER.debug("Iniciando construcción de parámetros para: {}", movement);

        params.put("contractId", movement.getContractId());
        params.put("microloanId", movement.getMicroloanId());
        params.put("date", new Date(movement.getInstallmentDate().getTime()));

        if (movement.getAmount() != null) {
            params.put("amount", movement.getAmount().getAmount());
        }

        if (movement.getAccount() != null && movement.getAccount().getEvent() != null) {
            params.put("eventCode", movement.getAccount().getEvent().getCode());
        }

        LOGGER.debug("Parámetros construidos: {}", params);
        return params;
    }
    

    public static Map<String, Object> buildParamsLogMovement(ProductInputDTO dto) {
            Map<String, Object> params = new HashMap<>();
            params.put("contractId", dto.getContractId());
            params.put("operationPageId", dto.getMicroloanId());
            params.put("date", new java.sql.Date(dto.getInstallmentDate().getTime()));
            return params;
        }

       
    }



