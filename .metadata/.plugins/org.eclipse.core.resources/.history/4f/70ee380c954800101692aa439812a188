    // ======================
    // UPDATE OPERATIONS
    // ======================

    @Override
    public int executeUpdateMicrocreditContract(Map<String, Object> args) {
        return executeUpdate(Constants.UPDATE_MICROCREDIT_CONTRACT, args);
    }

    @Override
    public int executeUpdateDisposition(Map<String, Object> args) {
        return executeUpdate(Constants.UPDATE_MCRCR_DISPOSITION, args);
    }

    @Override
    public int executeUpdateAmortizationContition(Map<String, Object> args) {
        return executeUpdate(Constants.UPDATE_AMORTIZATION_CONDITION, args);
    }

    @Override
    public int executeUpdateDspnAmort(Map<String, Object> args) {
        return executeUpdate(Constants.UPDATE_MCRCR_AMORTIZATION, args);
    }

    private int executeUpdate(String queryKey, Map<String, Object> args) {
        try {
            LOGGER.info("Actualizando con queryKey: {}, contrato: {}", queryKey, args.get("contractId"));
            int rows = jdbcUtils.update(queryKey, args);
            LOGGER.info("Actualización exitosa. Filas afectadas: {}", rows);
            return rows;
        } catch (DBException e) {
            LOGGER.error("Error en actualización de contrato: {}", args.get("contractId"), e);
            return 0;
        }
    }

    /**
     * Inserta una lista de movimientos en lote
     */
    public int executeInsertMicroloanMovements(List<MicroloanMovement> movements) {
        if (movements == null || movements.isEmpty()) {
            LOGGER.warn("Lista de movimientos vacía. No se insertará nada.");
            return 0;
        }

        try {
            LOGGER.info("Insertando {} movimientos", movements.size());
            return kmicR060.executeCreateMicroloanMovements(movements);
        } catch (Exception e) {
            LOGGER.error("Error al insertar movimientos microcrédito", e);
            return 0;
        }
    }
