public class KMICR092Impl extends KMICR092Abstract {

    private static final Logger LOGGER = LoggerFactory.getLogger(KMICR092Impl.class);

    /**
     * Ejecuta el proceso principal para obtener movimientos y aplicar reversos
     */
    @Override
    public void executeGetReversePayments(List<ProductInputDTO> items) {
        if (items == null || items.isEmpty()) {
            LOGGER.warn("No se recibieron elementos para procesar reversos.");
            return;
        }

        for (ProductInputDTO dto : items) {
            LOGGER.info("[KMICR092] DTO recibido: {}", dto);

            MicroloanMovement input = Mapper.mapToMicroloanMovement(dto);
            MicroloanMovement fetched = getMicroloanMovement(input);

            if (fetched != null) {
                List<MicroloanMovement> movements = getMovements(Mapper.buildQueryParams(input));
                applyReversals(movements);
            } else {
                LOGGER.warn("No se encontró movimiento para DTO: {}", dto);
            }
        }
    }

    /**
     * Consulta un movimiento de microcrédito
     */
    public MicroloanMovement getMicroloanMovement(MicroloanMovement input) {
        try {
            LOGGER.info("Buscando movimiento con parámetros: {}", input);
            MicroloanMovement result = kmicR060.executeGetMicroloanMovement(input);

            if (result != null) {
                LOGGER.info("Movimiento encontrado: {}", result);
            } else {
                LOGGER.warn("No se encontró movimiento con los parámetros dados.");
            }

            return result;
        } catch (Exception e) {
            LOGGER.error("Error consultando movimiento microcrédito", e);
            return null;
        }
    }

    /**
     * Consulta lista de movimientos desde base de datos
     */
    @Override
    public List<MicroloanMovement> getMovementList(Map<String, Object> params) {
        return getMovements(params);
    }

    private List<MicroloanMovement> getMovements(Map<String, Object> params) {
        try {
            LOGGER.info("Ejecutando consulta de movimientos con parámetros: {}", params);
            List<Map<String, Object>> result = jdbcUtils.queryForList(Constants.SELECT_TRAE_DATOS_LOG, params);
            return Mapper.mapListMicroloanMovement(result);
        } catch (Exception e) {
            LOGGER.error("Error al recuperar movimientos. Contrato: {}", params.get("contractId"), e);
            return Collections.emptyList();
        }
    }

    /**
     * Aplica reversos según tipo de evento
     */
    private void applyReversals(List<MicroloanMovement> movements) {
        if (movements == null || movements.isEmpty()) {
            LOGGER.info("No hay movimientos para aplicar reversos.");
            return;
        }

        for (MicroloanMovement m : movements) {
            String code = m.getAccount().getEvent().getCode();
            LOGGER.debug("Procesando reverso para evento: {}", code);

            switch (code) {
                case Diccionario.PGMNCMDI -> reversePgmncmdi(m);
                case Diccionario.ANULDISP -> reverseAnuldisp(m);
                case Diccionario.PAGMENCA -> reversePagmenca(m);
                default -> LOGGER.warn("Código de evento desconocido: {}. Se omite reverso.", code);
            }
        }
    }

